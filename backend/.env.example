# ==============================================================================
# AdShield Backend - Environment Variables Template
# ==============================================================================
# For Local Development: Copy this file to backend/.env and populate with keys.
# For Render Deployment: Configure these variables in Render Dashboard -> Environment.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration (comma-separated origins allowed by browser clients)
# In production, specify your Vercel frontend domain alongside localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173,https://your-frontend.vercel.app

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Gemini Cooldown Durations (in seconds)
# Daily quota reset calculates automatically until midnight America/Los_Angeles (Pacific Time)
GEMINI_DAILY_QUOTA_COOLDOWN_SECONDS=3600.0
GEMINI_RPM_COOLDOWN_SECONDS=60.0
GEMINI_TPM_COOLDOWN_SECONDS=60.0

# Google Safe Browsing API Configuration (v5 SearchUrls)
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
SAFE_BROWSING_TIMEOUT_SECONDS=6.0

# Tesseract OCR Executable Path
# On Linux / Render Docker: /usr/bin/tesseract
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe (or leave empty if on system PATH)
TESSERACT_CMD=/usr/bin/tesseract

# Upload Constraints
MAX_FILE_SIZE_BYTES=10485760
