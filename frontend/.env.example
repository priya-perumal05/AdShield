# ==============================================================================
# AdShield Frontend - Environment Variables Template
# ==============================================================================
# In local development:
# Leave VITE_API_BASE_URL blank to use the Vite local dev proxy (proxies /api to http://127.0.0.1:8000).
#
# In production (e.g. Vercel deployment):
# Set VITE_API_BASE_URL to your deployed Render backend service URL.
# Example: VITE_API_BASE_URL=https://adshield-backend.onrender.com
#
# Note: Never place secret API keys (Gemini, Google Safe Browsing) in frontend env files.
# All secret keys belong strictly in backend environment variables.
# ==============================================================================

VITE_API_BASE_URL=
